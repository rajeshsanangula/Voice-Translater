<Window x:Class="VTTranslate.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Height="320" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BrandWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image x:Name="LogoImage" Grid.Row="0" Height="64" HorizontalAlignment="Center"
               Stretch="Uniform" Margin="0,0,0,16" />
        <TextBlock x:Name="FallbackWordmark" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16"
                   FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandNavyBrush}">
            AUTRAXIS <Run Foreground="{StaticResource BrandGraySubtleBrush}" FontWeight="Normal">SYSTEMS INC.</Run>
        </TextBlock>

        <TextBlock Grid.Row="1" Text="Voice-Translater" FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Foreground="{StaticResource BrandNavyBrush}" />

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,16,0,0">
            <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Style="{StaticResource HintText}" />
            <TextBlock Text="Real-time German ⇄ English voice translation"
                       HorizontalAlignment="Center" Style="{StaticResource HintText}" Margin="0,4,0,0" />
        </StackPanel>

        <Button Grid.Row="3" Content="Close" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Center" Width="100" Click="Close_Click" />
    </Grid>
</Window>

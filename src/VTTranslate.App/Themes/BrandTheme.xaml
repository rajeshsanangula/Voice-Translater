<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette derived from the supplied AUTRAXIS SYSTEMS INC. mark (a two-tone blue
        arc over a dark-navy wordmark, on a light neutral ground) — a UI color system
        inspired by the brand, not a reproduction of the logo artwork itself. The logo
        image files are used as-is (see Branding/BrandAssets.cs); nothing here recolors,
        redraws, or alters them.
    -->

    <Color x:Key="BrandBlueLightColor">#1CA6F2</Color>
    <Color x:Key="BrandBlueDeepColor">#0B4DE8</Color>
    <Color x:Key="BrandNavyColor">#0E1526</Color>
    <Color x:Key="BrandNavySoftColor">#3A4256</Color>
    <Color x:Key="BrandGraySubtleColor">#8B93A3</Color>
    <Color x:Key="BrandRingColor">#E3E8F0</Color>
    <Color x:Key="BrandBackgroundColor">#F7F9FC</Color>
    <Color x:Key="BrandSurfaceColor">#FFFFFF</Color>
    <Color x:Key="BrandBorderColor">#DDE3EC</Color>

    <Color x:Key="StatusGoodColor">#1BA672</Color>
    <Color x:Key="StatusWarnColor">#C98A12</Color>
    <Color x:Key="StatusErrorColor">#D33B3B</Color>
    <Color x:Key="StatusMutedColor">#7A8496</Color>

    <SolidColorBrush x:Key="BrandBlueLightBrush" Color="{StaticResource BrandBlueLightColor}" />
    <SolidColorBrush x:Key="BrandBlueDeepBrush" Color="{StaticResource BrandBlueDeepColor}" />
    <SolidColorBrush x:Key="BrandNavyBrush" Color="{StaticResource BrandNavyColor}" />
    <SolidColorBrush x:Key="BrandNavySoftBrush" Color="{StaticResource BrandNavySoftColor}" />
    <SolidColorBrush x:Key="BrandGraySubtleBrush" Color="{StaticResource BrandGraySubtleColor}" />
    <SolidColorBrush x:Key="BrandRingBrush" Color="{StaticResource BrandRingColor}" />
    <SolidColorBrush x:Key="BrandBackgroundBrush" Color="{StaticResource BrandBackgroundColor}" />
    <SolidColorBrush x:Key="BrandSurfaceBrush" Color="{StaticResource BrandSurfaceColor}" />
    <SolidColorBrush x:Key="BrandBorderBrush" Color="{StaticResource BrandBorderColor}" />

    <SolidColorBrush x:Key="StatusGoodBrush" Color="{StaticResource StatusGoodColor}" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="{StaticResource StatusWarnColor}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusMutedBrush" Color="{StaticResource StatusMutedColor}" />

    <LinearGradientBrush x:Key="BrandAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandBlueLightColor}" Offset="0" />
        <GradientStop Color="{StaticResource BrandBlueDeepColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="BrandFont">Segoe UI</FontFamily>

    <Style TargetType="Window" x:Key="BrandWindowStyle">
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="Background" Value="{StaticResource BrandBackgroundBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- Card container used in place of the default GroupBox chrome -->
    <Style TargetType="Border" x:Key="CardBorder">
        <Setter Property="Background" Value="{StaticResource BrandSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style TargetType="TextBlock" x:Key="SectionHeaderText">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrandNavyBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style TargetType="TextBlock" x:Key="FieldLabelText">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrandNavySoftBrush}" />
        <Setter Property="Margin" Value="0,10,0,3" />
    </Style>

    <Style TargetType="TextBlock" x:Key="HintText">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource BrandGraySubtleBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Primary action button (brand-blue) -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{StaticResource BrandAccentGradient}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Rectangle Margin="-2" Stroke="{StaticResource BrandBlueDeepBrush}" StrokeThickness="2" StrokeDashArray="1 2" RadiusX="6" RadiusY="6" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.92" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary (neutral) button -->
    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="Background" Value="{StaticResource BrandSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BrandNavyBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrandBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Mute toggle — distinct destructive/attention styling when active. Varies
        Background/BorderBrush/Foreground via a DataTrigger on the SAME style, rather than
        swapping to a different Style object — WPF does not allow a Style (or a trigger
        within it) to set the Style property of the element it applies to.
    -->
    <Style TargetType="Button" x:Key="MuteButtonStyle" BasedOn="{StaticResource SecondaryButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMicrophoneMuted}" Value="True">
                <Setter Property="Background" Value="#FDEDEC" />
                <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}" />
                <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="{StaticResource BrandSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource BrandSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
